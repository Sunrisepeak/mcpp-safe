{
  "profile": [
    "safe",
    "modules"
  ],
  "features": {
    "json-brace-init": "deny",
    "exceptions": "deny",
    "rtti": "warn",
    "raw-pointers": "warn",
    "lib:std.vector": "allow"
  },
  "modules": {
    "app.legacy": {
      "goto": "allow",
      "c-array": "warn"
    },
    "app.legacy:io": {
      "c-array": "allow"
    }
  },
  "namespaces": {
    "app::ffi": {
      "raw-pointers": "allow",
      "c-varargs": "allow"
    }
  },
  "imports": {
    "vendor.zlib": {
      "allow": [
        "c-array",
        "raw-pointers"
      ],
      "reason": "zlib's C interface, wrapped in app::compress"
    }
  },
  "files": {
    "src/compat/**": {
      "include": "allow",
      "macros": "warn"
    },
    "src/compat/zlib_shim.cpp": {
      "macros": "allow"
    }
  }
}
