{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Sunrisepeak/mcpp-safe/specs/schema/mc1-audit.schema.json",
  "title": "MC1 0.1.0: one audit record (one line of the MCXX_AUDIT file)",
  "type": "object",
  "required": ["feature", "path", "line", "column", "declaration", "reason"],
  "additionalProperties": false,
  "properties": {
    "feature": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "minLength": 1 },
    "line": { "type": "integer", "minimum": 1 },
    "column": { "type": "integer", "minimum": 1 },
    "declaration": { "type": "string" },
    "reason": { "type": "string" }
  }
}
