// Generated by plugins/lang/cxx_status.py from Clang 23.1's clang/www/cxx_status.html: every core-language
// paper of C++29 (the plan's ML.1), and its status in that Clang. Do not edit; run the script again.
export module mcxx.plugins.lang.cpp29:table;

import std;

export namespace mcxx::plugins::lang::cpp29 {

enum class Status {
    baseline,   // Clang 23.1 implements it: the feature is gated, and -std turns it on
    partial,    // Clang 23.1 implements part of it: MC++'s Clang finishes it
    todo,       // MC++'s Clang implements it (llvm-clang-dev's lang/cpp29/<feature>)
};

struct Paper {
    std::string_view id;        // the MC1 feature id (category standard)
    std::string_view paper;     // the WG21 paper that adopted it
    std::string_view title;     // as the status page names it
    Status status;
    std::string_view clang;     // the status page's own words
};

