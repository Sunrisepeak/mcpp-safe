    { "c++29:nondeterministic-pointer-provenance", "P2434R5", "Nondeterministic pointer provenance", Status::todo, "No" },
    { "c++29:invalid-pointer-operations", "P3347R6", "Invalid pointer operations", Status::todo, "No" },
    { "c++29:unicode-identifier-recommendations", "P3658R1", "Adjust identifier following new Unicode recommendations", Status::todo, "No" },
    { "c++29:return-value-and-return-void", "P3950R1", "return_value & return_void are not mutually exclusive", Status::todo, "No" },
    { "c++29:more-named-universal-character-escapes", "P3733R1", "More named universal character escapes", Status::baseline, "Clang 23" },
    { "c++29:lexical-order-lambdas", "P3847R1", "Lexical order for lambdas", Status::baseline, "Clang 3.1" },
